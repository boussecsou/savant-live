.claude/

# SAVANT — project specific
*.db          # runtime SQLite databases (memory.db, etc.)
logs/         # runtime logs generated by SAVANT
backups/      # SQLite backup files — data, not code
memory/       # persistent memory folder
VPS_Report.md # My personal VPS report

hermes-agent.env  # Hermes secrets (OPENROUTER_API_KEY, API_SERVER_KEY) — never commit
hermes-agent.env
*.bak
*.bak.*
