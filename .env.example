# ─────────────────────────────────────────────
# SAVANT — Environment Configuration Template
# Copy this file to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────

# ── Gemini API (required) ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Redis connection (internal Docker network) ─
REDIS_HOST=redis-container
REDIS_PORT=6379
REDIS_PASSWORD=        # leave empty if Redis has no auth

# ── SAVANT backend ─────────────────────────────
SAVANT_ENV=production
SAVANT_PORT=8000

# ── Hermes v2 execution agent ──────────────────
# Internal Docker network addresses — do not change unless you renamed services
HERMES_URL=http://hermes-v2:8642
CONSOLE_EXEC_BASE=http://hermes-v2:8644
HERMES_WEBHOOK_SECRET=your-secret-here    # shared between backend and Hermes
OPENROUTER_API_KEY=your-openrouter-key-here

# ── Paths (defaults match Docker volume mounts) ─
LOG_DIR=/app/logs
DB_PATH=/app/memory/savant.db
SKILLS_DIR=/app/skills

# ── Notion (optional) ──────────────────────────
# When set, SAVANT exposes a fast-read lane for Notion pages.
# Leave empty to keep Notion disabled — nothing breaks without it.
NOTION_API_KEY=
